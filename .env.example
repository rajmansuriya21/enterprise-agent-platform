# ============================================================
# Enterprise Multi-Agent Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- LLM Provider ---
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Embedding Model ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Qdrant Vector Store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_docs

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# --- SQLite Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/enterprise.db

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=enterprise-agent-platform

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# --- Streamlit ---
STREAMLIT_PORT=8501
STREAMLIT_BACKEND_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Security ---
API_KEY=your-api-key-for-authentication
RATE_LIMIT_RPM=60
